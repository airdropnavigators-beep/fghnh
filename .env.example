# --- Application ---
APP_NAME=FlowForge
ENVIRONMENT=development

# true = run locally with mock providers and an in-memory repository (no AWS needed)
# false = use real AWS services (Bedrock, Textract, S3, DynamoDB)
DEMO_MODE=true

# Demo user (hardcoded; no real authentication)
DEMO_USER_ID=demo-user

# --- HTTP ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- AI / Bedrock ---
# Model identifiers (update region/ids for your account)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# Model used for fast, cheap structured outputs (optional)
BEDROCK_FAST_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MAX_RETRIES=3
BEDROCK_RETRY_BASE_SECONDS=1.0

# --- AWS resources ---
AWS_S3_BUCKET=flowforge-documents
AWS_DYNAMODB_TABLE_WORKFLOWS=flowforge-workflows
AWS_DYNAMODB_TABLE_DOCUMENTS=flowforge-documents
AWS_DYNAMODB_TABLE_AUDIT=flowforge-audit

# --- Documents ---
MAX_DOCUMENT_SIZE_MB=10
ALLOWED_MIME_TYPES=["application/pdf","image/png","image/jpeg"]
# Textract: PNG/JPEG up to this size use the synchronous Bytes API; PDFs and larger
# images go through the asynchronous S3-backed job (polled).
TEXTRACT_SYNC_MAX_BYTES=5242880
TEXTRACT_ASYNC_POLL_SECONDS=1.5
TEXTRACT_ASYNC_TIMEOUT_SECONDS=60
# DynamoDB TTL for workflow/document/audit rows in days (0 = never expire). Align with the
# S3 lifecycle rule (DocumentRetentionDays in infrastructure/template.yaml).
RECORD_RETENTION_DAYS=0

# --- Confidence gating ---
CONFIDENCE_PASS=0.85
CONFIDENCE_WARN=0.60

# --- Feature flags ---
WORKFLOW_RETRY_ON_INVALID=true