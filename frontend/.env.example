# Frontend runtime switches (Vite exposes only VITE_* to the browser).

# "true" (default) runs the deterministic in-browser mock — no backend needed.
# "false" talks to the FastAPI backend. The dev server proxies /api -> http://127.0.0.1:8000.
VITE_USE_MOCK=true

# Base URL for the live API. Leave as /api in development (proxied); set the deployed
# API Gateway URL for production builds, e.g. https://abc123.execute-api.us-east-1.amazonaws.com/prod
VITE_API_BASE=/api

# The mode can also be flipped without rebuilding: append ?api=live or ?api=mock to the URL,
# or use the "Offline demo / Live API" switch in the header (persisted in localStorage).
